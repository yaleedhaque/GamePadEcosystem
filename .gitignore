# ── Build Artifacts ──
build/windows/output/
build/android/output/
*.msi
*.exe

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ──
Thumbs.db
Desktop.ini
.DS_Store

# ── Logs ──
logs/*.log

# ── Secrets ──
*.pem
*.key
.env
